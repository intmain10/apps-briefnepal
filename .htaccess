# =========================================================================
# OmniTools — Apache configuration (shared-hosting friendly)
# =========================================================================

# ---- Default charset & directory behaviour -----------------------------
AddDefaultCharset UTF-8
DirectoryIndex index.php
Options -Indexes +FollowSymLinks

# ---- Custom error document ---------------------------------------------
ErrorDocument 404 /404.php

# =========================================================================
# URL rewriting — clean, SEO-friendly URLs
# =========================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS (comment out if your host handles this at the proxy layer)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Strip trailing slash (except real directories)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # =====================================================================
    # Cardly domain (cardly.briefnepal.com) — serve ONLY Cardly. Runs before
    # the OmniTools rules so tools/blog/category/etc. never render here.
    # =====================================================================
    # OmniTools sections don't belong on the Cardly domain → send to main site
    RewriteCond %{HTTP_HOST} ^cardly\.briefnepal\.com$ [NC]
    RewriteRule ^(tools|category|blog|privacy|terms|contact|changelog|feedback|sitemap|shushant-singh|founder|docs|guide|manual)(/.*)?$ https://apps.briefnepal.com/$1$2 [R=301,L]
    # Cardly landing
    RewriteCond %{HTTP_HOST} ^cardly\.briefnepal\.com$ [NC]
    RewriteRule ^$ cardly.php [L,QSA]
    # Cardly About
    RewriteCond %{HTTP_HOST} ^cardly\.briefnepal\.com$ [NC]
    RewriteRule ^about/?$ cardly-about.php [L,QSA]
    # Builder
    RewriteCond %{HTTP_HOST} ^cardly\.briefnepal\.com$ [NC]
    RewriteRule ^new/?$ cardly-edit.php [L,QSA]
    # Accounts
    RewriteCond %{HTTP_HOST} ^cardly\.briefnepal\.com$ [NC]
    RewriteRule ^(login|signup|logout|dashboard|verify|forgot|reset|resend)/?$ cardly-account.php?do=$1 [L,QSA]
    # Card edit
    RewriteCond %{HTTP_HOST} ^cardly\.briefnepal\.com$ [NC]
    RewriteRule ^([a-z0-9-]{1,40})/edit/?$ cardly-edit.php?slug=$1 [L,QSA]
    # Stray /cardly/* on the Cardly domain → short form
    RewriteCond %{HTTP_HOST} ^cardly\.briefnepal\.com$ [NC]
    RewriteRule ^cardly/(.*)$ https://cardly.briefnepal.com/$1 [R=301,L]
    # Bare segment = a card (skip real files/dirs)
    RewriteCond %{HTTP_HOST} ^cardly\.briefnepal\.com$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]{1,40})/?$ cardly-view.php?slug=$1 [L,QSA]

    # Sitemaps & robots
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^sitemap-index\.xml$ sitemap.php?type=index [L]
    RewriteRule ^sitemap-([a-z]+)\.xml$ sitemap.php?type=$1 [L]
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^llms\.txt$ llms.php [L]

    # All-tools directory
    RewriteRule ^tools/?$ tools.php [L,QSA]

    # Categories
    RewriteRule ^category/([a-z0-9-]+)/?$ category.php?cat=$1 [L,QSA]

    # Blog
    RewriteRule ^blog/?$ blog/index.php [L,QSA]
    RewriteRule ^blog/([a-z0-9-]+)/?$ blog/post.php?slug=$1 [L,QSA]

    # Founder / person entity page
    RewriteRule ^(shushant-singh|founder)/?$ founder.php [L,QSA]

    # ---- Main host: 301 old /cardly/* links to the Cardly domain ----
    RewriteCond %{HTTP_HOST} ^apps\.briefnepal\.com$ [NC]
    RewriteRule ^cardly/([a-z0-9-]{1,40})/edit/?$ https://cardly.briefnepal.com/$1/edit [R=301,L,QSA]
    RewriteCond %{HTTP_HOST} ^apps\.briefnepal\.com$ [NC]
    RewriteRule ^cardly/(login|signup|logout|dashboard|verify|forgot|reset|resend|new)/?$ https://cardly.briefnepal.com/$1 [R=301,L,QSA]
    RewriteCond %{HTTP_HOST} ^apps\.briefnepal\.com$ [NC]
    RewriteRule ^cardly/([a-z0-9-]{1,40})/?$ https://cardly.briefnepal.com/$1 [R=301,L,QSA]
    RewriteCond %{HTTP_HOST} ^apps\.briefnepal\.com$ [NC]
    RewriteRule ^cardly/?$ https://cardly.briefnepal.com/ [R=301,L]

    # ---- Fallback for any other host (local dev): legacy /cardly/* paths ----
    RewriteRule ^cardly/?$ cardly.php [L,QSA]
    RewriteRule ^cardly/new/?$ cardly-edit.php [L,QSA]
    RewriteRule ^cardly/(login|signup|logout|dashboard|verify|forgot|reset|resend)/?$ cardly-account.php?do=$1 [L,QSA]
    RewriteRule ^cardly/([a-z0-9-]+)/edit/?$ cardly-edit.php?slug=$1 [L,QSA]
    RewriteRule ^cardly/([a-z0-9-]+)/?$ cardly-view.php?slug=$1 [L,QSA]

    # User guide / documentation (aliases 301 to the canonical /docs)
    RewriteRule ^(guide|manual)/?$ /docs [R=301,L]
    RewriteRule ^docs/?$ docs.php [L,QSA]

    # Static pages
    RewriteRule ^(about|privacy|terms|contact|changelog|sitemap|feedback)/?$ page.php?p=$1 [L,QSA]

    # Fallback: single clean segment → tool page (only if not a real file/dir)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/?$ tool.php?slug=$1 [L,QSA]
</IfModule>

# =========================================================================
# Performance — compression
# =========================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# =========================================================================
# Performance — browser caching
# =========================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Long cache for static assets
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Service worker must NOT be long-cached (so updates ship) + root scope
    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </Files>

    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# =========================================================================
# Security — block access to sensitive files
# =========================================================================
<FilesMatch "^(config\.php|config\.local\.php|\.htaccess|.*\.sql|.*\.log|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Block access to the includes directory from the web
RewriteRule ^includes/ - [F,L]

# PHP upload limits (works on hosts using PHP as an Apache module)
<IfModule mod_php.c>
    php_value upload_max_filesize 50M
    php_value post_max_size 52M
    php_value max_execution_time 120
</IfModule>
